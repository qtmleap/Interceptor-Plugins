shape: sequence_diagram
style.fill: transparent

client: "@@CLIENT@@" {style.border-radius: 8; style.stroke: "@@NEUTRAL@@"}
interceptor: Interceptor {style.border-radius: 8; style.stroke: "@@NEUTRAL@@"}
server: "@@SERVER@@" {style.border-radius: 8; style.stroke: "@@NEUTRAL@@"}

client -> interceptor: "@@REQUEST@@" {style.stroke-width: 2; style.stroke: "@@NEUTRAL@@"}
interceptor -> interceptor: "request.onEnter\n@@BEFORE_REQUEST@@" {
  style.stroke: "@@ACCENT@@"
  style.font-color: "@@ACCENT@@"
  style.stroke-width: 2
}
interceptor -> server: "@@SEND@@" {style.stroke-width: 2; style.stroke: "@@NEUTRAL@@"}
interceptor -> interceptor: "request.onLeave\n@@AFTER_REQUEST@@" {
  style.stroke: "@@NEUTRAL@@"
  style.font-color: "@@NEUTRAL@@"
  style.stroke-dash: 4
}
server -> interceptor: "@@RESPONSE@@" {style.stroke-width: 2; style.stroke: "@@NEUTRAL@@"}
interceptor -> interceptor: "response.onEnter\n@@BEFORE_RESPONSE@@" {
  style.stroke: "@@ACCENT@@"
  style.font-color: "@@ACCENT@@"
  style.stroke-width: 2
}
interceptor -> client: "@@RETURN@@" {style.stroke-width: 2; style.stroke: "@@NEUTRAL@@"}
interceptor -> interceptor: "response.onLeave\n@@AFTER_RESPONSE@@" {
  style.stroke: "@@NEUTRAL@@"
  style.font-color: "@@NEUTRAL@@"
  style.stroke-dash: 4
}
