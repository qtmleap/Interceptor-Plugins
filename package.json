{
  "name": "interceptor-plugin-repository",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "bun": "1.3.6"
  },
  "scripts": {
    "build": "python3 tools/build_dev.py --root .",
    "build:dev": "bun run build",
    "check": "tools/check.sh",
    "setup": "python3 tools/setup.py --root .",
    "check:authoring": "tools/check-authoring.sh",
    "docs:context": "python3 tools/docs_context.py --root . --output build/docs-context.json",
    "docs:examples": "python3 tools/docs_examples.py --root .",
    "docs:dev": "bun run docs:examples && bun run docs:context && bun --bun vitepress dev website",
    "docs:build": "bun run diagrams:check && bun run docs:examples && bun run docs:context && bun --bun vitepress build website",
    "docs:preview": "bun --bun vitepress preview website",
    "check:docs": "bun run docs:build && python3 tools/check_docs.py --root . --site build/docs",
    "simulator": "tools/simulator.sh",
    "check:native": "tools/check-native.sh",
    "diagrams:render": "bun tools/render-hook-diagrams.ts",
    "diagrams:check": "bun tools/render-hook-diagrams.ts --check",
    "check:lint": "tools/check-lint.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "js-sha256": "1.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "vitepress": "1.6.4"
  },
  "packageManager": "bun@1.3.6"
}
