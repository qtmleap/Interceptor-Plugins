import { readFileSync } from 'node:fs'
import { fileURLToPath } from 'node:url'

export interface DocsContext {
  name: string
  repositoryURL: string
  githubRepository: string
  fingerprint: string | null
  bunVersion: string
  base: string
}

const contextFile = fileURLToPath(new URL('../../build/docs-context.json', import.meta.url))

// Generated by tools/docs_context.py from the validated repository-config.json.
export function loadContext(): DocsContext {
  let raw: string
  try {
    raw = readFileSync(contextFile, 'utf8')
  } catch {
    throw new Error('Missing build/docs-context.json; run `bun run docs:context` first')
  }
  const context = JSON.parse(raw) as DocsContext
  for (const key of ['name', 'repositoryURL', 'githubRepository', 'bunVersion', 'base'] as const) {
    if (typeof context[key] !== 'string') throw new Error(`Invalid documentation context: ${key}`)
  }
  return context
}

export const TOKEN = /%%(REPOSITORY_NAME|REPOSITORY_URL|FINGERPRINT|GITHUB_REPOSITORY|BUN_VERSION)%%/g

export type Token = 'REPOSITORY_NAME' | 'REPOSITORY_URL' | 'FINGERPRINT' | 'GITHUB_REPOSITORY' | 'BUN_VERSION'

export interface Texts {
  unconfigured: string
}

export function plainValues(context: DocsContext, texts: Texts): Record<Token, string> {
  return {
    REPOSITORY_NAME: context.name,
    REPOSITORY_URL: context.repositoryURL,
    FINGERPRINT: context.fingerprint ?? texts.unconfigured,
    GITHUB_REPOSITORY: context.githubRepository,
    BUN_VERSION: context.bunVersion
  }
}

// Text that is safe in HTML and cannot open a Vue interpolation or directive.
export function escapeText(value: string): string {
  return value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;')
    .replace(/\{/g, '&#123;')
    .replace(/\}/g, '&#125;')
}

export function substitute(text: string, values: Record<Token, string>, escape: (value: string) => string = (v) => v): string {
  return text.replace(TOKEN, (_, token: Token) => escape(values[token]))
}
